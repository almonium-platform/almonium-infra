services:
  alloy:
    image: "{{ monitoring_alloy_image }}"
    container_name: alloy
    command:
      - run
      - --server.http.listen-addr=0.0.0.0:12345
      - --storage.path=/var/lib/alloy/data
      - /etc/alloy/config.alloy
    env_file: alloy.env
    # The Docker socket lets Alloy discover containers and read their logs.
    # It is root-equivalent on the host, which is why this stack has no
    # inbound route and its UI binds to localhost only (use an SSH tunnel).
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - alloy-data:/var/lib/alloy/data
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /proc:/host/proc:ro
      - /sys:/sys:ro
      - /:/host/root:ro,rslave
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
      - /run/udev/data:/run/udev/data:ro
    ports:
      - "127.0.0.1:12345:12345"
    networks:
      # proxy-net reaches the backend slots, broker-net reaches RabbitMQ,
      # db-net reaches PostgreSQL.
      - proxy-net
      - broker-net
      - db-net
    restart: unless-stopped

volumes:
  alloy-data:

networks:
  proxy-net:
    external: true
  broker-net:
    external: true
  db-net:
    external: true
