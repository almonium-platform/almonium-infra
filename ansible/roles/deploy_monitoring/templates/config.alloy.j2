// Grafana Alloy on the shared host: host and container metrics, the Almonium
// backend's Micrometer metrics, RabbitMQ metrics, and every container's logs,
// all shipped to Grafana Cloud. The free tier allows 10k active series, so
// each source keeps only what the dashboards and alerts use.

logging {
  level = "warn"
}

// ---------------------------------------------------------------- outputs

prometheus.remote_write "cloud" {
  endpoint {
    url = "{{ monitoring_grafana_cloud.prometheus.url }}"

    basic_auth {
      username = "{{ monitoring_grafana_cloud.prometheus.username }}"
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }

  external_labels = {
    host = "{{ monitoring_host_label }}",
  }
}

loki.write "cloud" {
  endpoint {
    url = "{{ monitoring_grafana_cloud.loki.url }}"

    basic_auth {
      username = "{{ monitoring_grafana_cloud.loki.username }}"
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }

  external_labels = {
    host = "{{ monitoring_host_label }}",
  }
}

// ---------------------------------------------------------------- host

prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/sys"
  rootfs_path = "/host/root"

  set_collectors = [
    "cpu", "diskstats", "filesystem", "loadavg", "meminfo", "netdev",
    "pressure", "stat", "time", "uname", "vmstat", "os",
  ]

  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|mqueue|nsfs|overlay|proc|pstore|rpc_pipefs|securityfs|squashfs|sysfs|tmpfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker/.+)($|/)"
  }

  netdev {
    device_exclude = "^(lo|veth.*|br-.*|docker0)$"
  }
}

// The exporters name their target after Alloy's container id, which changes on
// every redeploy; name it after the host so alerts keep one series.
discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "instance"
    replacement  = "{{ monitoring_host_label }}"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  job_name        = "integrations/unix"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.cloud.receiver]
}

// ---------------------------------------------------------------- containers

prometheus.exporter.cadvisor "containers" {
  docker_host      = "unix:///var/run/docker.sock"
  docker_only      = true
  storage_duration = "5m"
}

discovery.relabel "cadvisor" {
  targets = prometheus.exporter.cadvisor.containers.targets

  rule {
    target_label = "instance"
    replacement  = "{{ monitoring_host_label }}"
  }
}

prometheus.scrape "containers" {
  targets         = discovery.relabel.cadvisor.output
  job_name        = "integrations/cadvisor"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.containers.receiver]
}

prometheus.relabel "containers" {
  forward_to = [prometheus.remote_write.cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|memory_rss|spec_memory_limit_bytes|network_receive_bytes_total|network_transmit_bytes_total|fs_reads_bytes_total|fs_writes_bytes_total|oom_events_total|start_time_seconds|last_seen)|machine_(cpu_cores|memory_bytes)"
    action        = "keep"
  }

  // cAdvisor copies every Docker label (compose hashes, image descriptions,
  // Traefik rules) onto each series, and the cgroup id changes on every
  // recreate; the container name is the identity that matters.
  rule {
    regex  = "container_label_.*|id"
    action = "labeldrop"
  }
}

// ---------------------------------------------------------------- Docker discovery

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Container names follow <app>[_<env>][_<slot>], e.g. almonium_prod_green,
// almonium_books_worker_staging_blue, almonium_fe_prod, rabbitmq.
discovery.relabel "names" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.+?)(_(prod|staging))?(_(blue|green))?"
    target_label  = "app"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/.+?_(prod|staging)(_(blue|green))?"
    target_label  = "env"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/.+_(blue|green)"
    target_label  = "slot"
  }
}

// ---------------------------------------------------------------- Almonium backend

// The shared discovery reports each container once, on whichever network
// Docker lists first; the scrape needs the proxy-net address specifically.
discovery.docker "backend" {
  host                = "unix:///var/run/docker.sock"
  match_first_network = false
}

discovery.relabel "backend" {
  targets = discovery.docker.backend.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/almonium_(prod|staging)_(blue|green)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/almonium_(prod|staging)_(blue|green)"
    target_label  = "env"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/almonium_(prod|staging)_(blue|green)"
    target_label  = "slot"
    replacement   = "$2"
  }

  rule {
    target_label = "app"
    replacement  = "almonium"
  }

  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = "proxy-net"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_port_private"]
    regex         = "{{ almonium.shared.local_port }}"
    action        = "keep"
  }

  rule {
    target_label = "__metrics_path__"
    replacement  = "{{ almonium.shared.context_path }}/actuator/prometheus"
  }
}

prometheus.scrape "backend" {
  targets         = discovery.relabel.backend.output
  job_name        = "almonium-be"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.cloud.receiver]
}

// ---------------------------------------------------------------- RabbitMQ

prometheus.scrape "rabbitmq" {
  targets = [{
    __address__ = "rabbitmq:15692",
    app         = "rabbitmq",
  }]
  job_name        = "integrations/rabbitmq"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.cloud.receiver]
}

// Per-queue depth and consumers. The aggregate endpoint above sums every
// queue; this one names them, which is what shows a backlog or a dead letter.
prometheus.scrape "rabbitmq_queues" {
  targets = [{
    __address__ = "rabbitmq:15692",
    app         = "rabbitmq",
  }]
  job_name        = "integrations/rabbitmq-queues"
  metrics_path    = "/metrics/detailed"
  params          = {
    family = ["queue_coarse_metrics", "queue_consumer_count"],
  }
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.rabbitmq_queues.receiver]
}

prometheus.relabel "rabbitmq_queues" {
  forward_to = [prometheus.remote_write.cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "rabbitmq_detailed_queue_(messages_ready|messages_unacked|consumers)"
    action        = "keep"
  }

  // Celery names a queue per worker process; each restart would add series.
  rule {
    source_labels = ["queue"]
    regex         = "celeryev\\..*|.*\\.pidbox|amq\\.gen-.*|spring\\.gen-.*"
    action        = "drop"
  }
}

// ---------------------------------------------------------------- logs

// Logs only from Almonium's own containers, the services it depends on, and
// Alloy itself. Other tenants of the host still report resource metrics above.
discovery.relabel "logs" {
  targets = discovery.relabel.names.output

  rule {
    source_labels = ["app"]
    regex         = "almonium.*|traefik_proxy|postgres|pgbouncer|rabbitmq|alloy"
    action        = "keep"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.logs.output
  forward_to = [loki.process.containers.receiver]
}

loki.process "containers" {
  forward_to = [loki.write.cloud.receiver]

  // The backend's logback pattern colours its output; strip the escape codes
  // so the lines read cleanly and the patterns below can match them.
  stage.decolorize {}

  // Spring prints a stack trace across several lines; keep it with its entry.
  stage.match {
    selector = "{app=\"almonium\"}"

    stage.multiline {
      firstline     = "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}"
      max_wait_time = "3s"
    }
  }

  stage.regex {
    expression = "^.{0,48}?\\b(?P<level>TRACE|DEBUG|INFO|WARN|WARNING|ERROR|CRITICAL|FATAL)\\b"
  }

  stage.labels {
    values = {
      level = "",
    }
  }
}
