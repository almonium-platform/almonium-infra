services:
  app:
    image: "{{ deploy_image_reference }}"
    container_name: "almonium_{{ deploy_environment }}_{{ deploy_slot }}"
    environment:
      LOCAL_PORT: "{{ almonium.shared.local_port }}"
      DEBUG_PORT: "{{ almonium.shared.debug_port }}"
      CONTEXT_PATH: "{{ almonium.shared.context_path }}"

      SPRING_PROFILE: "{{ app_cfg.spring_profile }}"

      DB_NAME: "{{ app_cfg.db.name }}"
      DB_HOST: "{{ platform.db.host }}"
      DB_PORT: "{{ platform.db.port }}"
      DB_SCHEMA: "{{ app_cfg.db.schema }}"
      DB_USERNAME: "{{ app_cfg.db.username }}"
      DB_PASSWORD: "{{ almonium_env.db.password }}"

      RABBITMQ_HOST: "{{ platform.rabbitmq.host }}"
      RABBITMQ_PORT: "{{ platform.rabbitmq.port }}"
      RABBITMQ_USER: "{{ app_cfg.rabbitmq.username }}"
      RABBITMQ_PASS: "{{ almonium_env.rabbitmq.password }}"
      RABBITMQ_VHOST: "{{ app_cfg.rabbitmq.vhost }}"

      STREAM_KEY: "{{ almonium_env.stream.key }}"
      STREAM_SECRET: "{{ almonium_env.stream.secret }}"

      # Chat with Almo: the same shared key the books slot already uses.
      OPENAI_API_KEY: {{ almonium_shared.openai_key | to_json }}
      # The ops spend page reads the organisation's bill; that takes an Admin API key, not a project key.
      OPENAI_ADMIN_KEY: {{ almonium_shared.openai_admin_key | to_json }}

      PADDLE_ENVIRONMENT: {{ app_cfg.paddle_environment | to_json }}
      PADDLE_API_KEY: {{ almonium_env.paddle.api_key | to_json }}
      PADDLE_CLIENT_TOKEN: {{ almonium_env.paddle.client_token | to_json }}
      PADDLE_WEBHOOK_SECRET: {{ almonium_env.paddle.webhook_secret | to_json }}
      PADDLE_PRICE_PREMIUM_MONTHLY: {{ almonium_env.paddle.prices.premium_monthly | to_json }}
      PADDLE_PRICE_PREMIUM_ANNUAL: {{ almonium_env.paddle.prices.premium_annual | to_json }}
      PADDLE_PRICE_FOUNDER_MONTHLY: {{ almonium_env.paddle.prices.founder_monthly | to_json }}
      PADDLE_PRICE_FOUNDER_ANNUAL: {{ almonium_env.paddle.prices.founder_annual | to_json }}

      RAPID_API_KEY: "{{ almonium_shared.rapid_api_key }}"
      WORDNIK_KEY: "{{ almonium_shared.wordnik_key }}"
      YANDEX_KEY: "{{ almonium_shared.yandex_key }}"
      ZEPTO_API_KEY: "{{ almonium_shared.zepto_api_key }}"

      GOOGLE_SERVICE_ACCOUNT_KEY_BASE64: "{{ almonium_env.google_service_account_key_base64 }}"
      ALMONIUM_BOOKS_PUBLISHER_SECRET: "{{ almonium_shared.books.publisher_secret }}"
      ALMONIUM_BOOKS_PROCESSOR_URL: "{{ app_cfg.books_processor_url }}"

      # Audio clips: Cloudflare R2 through the S3 API, one bucket shared by both environments.
      AUDIO_S3_ENDPOINT: "{{ almonium.shared.audio.s3.endpoint }}"
      AUDIO_S3_REGION: "{{ almonium.shared.audio.s3.region }}"
      AUDIO_S3_BUCKET: "{{ almonium.shared.audio.s3.bucket }}"
      AUDIO_S3_ACCESS_KEY_ID: {{ almonium_shared.audio.s3.access_key_id | to_json }}
      AUDIO_S3_SECRET_ACCESS_KEY: {{ almonium_shared.audio.s3.secret_access_key | to_json }}

    ports:
      - "127.0.0.1:{{ local_healthcheck_port }}:{{ app_internal_port }}"

    networks:
      - proxy-net
      - broker-net
      - db-net

    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ app_internal_port }}{{ almonium.shared.context_path }}/actuator/health"]
      interval: 10s
      timeout: 3s
      retries: 3

    restart: unless-stopped

networks:
  proxy-net:
    external: true
  broker-net:
    external: true
  db-net:
    external: true
