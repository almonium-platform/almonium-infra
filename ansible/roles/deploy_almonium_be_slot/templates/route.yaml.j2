http:
  routers:
    almonium-be-{{ deploy_environment }}:
      rule: "Host(`{{ app_cfg.api_hostname }}`)"
      priority: 1000
      entryPoints:
        - websecure
      service: almonium-be-{{ deploy_environment }}
      middlewares:
        - almonium-be-{{ deploy_environment }}-slot
      tls:
        certResolver: porkbun

    # Alloy scrapes metrics over proxy-net; from the Internet the path is refused.
    almonium-be-{{ deploy_environment }}-metrics:
      rule: "Host(`{{ app_cfg.api_hostname }}`) && PathPrefix(`{{ almonium.shared.context_path }}/actuator/prometheus`)"
      priority: 2000
      entryPoints:
        - websecure
      service: almonium-be-{{ deploy_environment }}
      middlewares:
        - almonium-be-{{ deploy_environment }}-host-only
      tls:
        certResolver: porkbun

  services:
    almonium-be-{{ deploy_environment }}:
      loadBalancer:
        servers:
          - url: "http://almonium_{{ deploy_environment }}_{{ route_slot }}:{{ app_internal_port }}"

  middlewares:
    almonium-be-{{ deploy_environment }}-slot:
      headers:
        customResponseHeaders:
          X-Almonium-Deploy-Slot: "{{ route_slot }}"

    almonium-be-{{ deploy_environment }}-host-only:
      ipAllowList:
        sourceRange:
          - "127.0.0.1/32"
