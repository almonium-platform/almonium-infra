services:
  rabbitmq:
    image: rabbitmq:4.1.0-management
    container_name: rabbitmq
    environment:
      RABBITMQ_DEFAULT_USER: "{{ rabbitmq_admin_user }}"
      RABBITMQ_DEFAULT_PASS: "{{ rabbitmq_admin_password }}"
    ports:
      # Applications use broker-net directly. Keep administration available
      # through an SSH tunnel, without exposing RabbitMQ to the Internet.
      - "127.0.0.1:5672:5672"
      - "127.0.0.1:15672:15672"
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    networks:
      - broker-net
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 30s
      timeout: 5s
      retries: 3
    restart: unless-stopped

volumes:
  rabbitmq-data:

networks:
  broker-net:
    external: true
