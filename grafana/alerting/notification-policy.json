{
  "receiver": "Almonium email",
  "group_by": [
    "grafana_folder",
    "alertname"
  ],
  "group_wait": "30s",
  "group_interval": "5m",
  "repeat_interval": "12h",
  "routes": [
    {
      "receiver": "Almonium email",
      "object_matchers": [
        [
          "severity",
          "=",
          "critical"
        ]
      ],
      "repeat_interval": "2h"
    }
  ]
}